# Public site URL used for Open Graph metadata. On Vercel this falls back to VERCEL_URL.
NEXT_PUBLIC_SITE_URL=

# Supabase notes. Leave blank and the note form still succeeds (it logs the note on the server).
# The note wall then shows the sample notes in content/pages/home.json and gatherings.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin/notes. Leave blank to approve notes in the Supabase dashboard instead.
ADMIN_PASSWORD=

# Resend. Leave blank and the question form still succeeds (it logs the question on the server).
RESEND_API_KEY=
# Verified sender, for example "Immanuel Mensah <notes@yourdomain.com>".
# Resend's onboarding sender works for tests to the account email: "Portfolio <onboarding@resend.dev>"
RESEND_FROM=
CONTACT_EMAIL=tutuimmanuel10@gmail.com

# Cal.com link, for example immanuel-mensah/15min. Leave blank to show "Booking opens soon".
NEXT_PUBLIC_CALCOM_LINK=

# Set to 1 to show CHECK markers and STAND-IN tags on a preview deploy.
NEXT_PUBLIC_SHOW_CHECKS=
