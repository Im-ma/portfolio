  "howIWork": {
    "number": "02",
    "title": "How I work",
    "diagram": "signal-path",
    "steps": [
      {
        "label": "STEP 01",
        "title": "Listen",
        "text": "I start by talking with the people who will use it. The best ideas I have had came from someone describing a bad day."
      },
      {
        "label": "STEP 02",
        "title": "Design",
        "text": "I sketch and prototype in Figma, including the awkward screens: errors, empty states, the event that fills up."
      },
      {
        "label": "STEP 03",
        "title": "Build",
        "text": "Then I write the code, so the hard parts show up while they are still cheap to fix."
      }
    ]
  },
